{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.analysis.typeCheckingMode": "off",
    "files.exclude": {
      "**/__pycache__": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Mission Control (twin + camera/AI + IoT)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/mission_control.py",
        "args": [
          "--cropscout"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Mission Control (sim labels only)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/mission_control.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Mission Control + MQTT (test.mosquitto.org)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/mission_control.py",
        "args": [
          "--cropscout",
          "--mqtt",
          "test.mosquitto.org"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Live viewer (interactive)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/live_viewer.py",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "justMyCode": true
      },
      {
        "name": "Live viewer + CropSCOUT models (photos per plant)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/live_viewer.py",
        "args": [
          "--cropscout"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Live viewer + CropSCOUT models (webcam at each stop)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/live_viewer.py",
        "args": [
          "--cropscout",
          "--source",
          "webcam"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Render hero image + GIF (headless)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/render_demo.py",
        "args": [
          "out"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Render hero image + GIF + CropSCOUT (headless)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/render_demo.py",
        "args": [
          "out",
          "--cropscout"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      },
      {
        "name": "Live viewer (no camera)",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/live_viewer.py",
        "args": [
          "--no-camera"
        ],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal"
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Setup: create .venv + install",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\setup.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      },
      {
        "label": "Open scene in MuJoCo viewer (XML only)",
        "type": "shell",
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "-m",
          "mujoco.viewer",
          "--mjcf",
          "${workspaceFolder}\\out\\greenhouse_demo.xml"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ]
  }
}